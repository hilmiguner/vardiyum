{
  "expo": {
    "name": "Vardiyum",
    "slug": "vardiyum",
    "scheme": "vardiyum",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hilmiguner.vardiyum"
    },
    "android": {
      "package": "com.hilmiguner.vardiyum"
    },
    "plugins": [
      "expo-router",
      ["expo-sqlite", { "android": { "enableFTS": true } }],
      "expo-localization",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "0ec5a8c3-f277-43d0-82c7-8b822835a4c2"
      }
    }
  }
}
