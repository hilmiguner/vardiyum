{
  "expo": {
    "name": "Vardiyum",
    "slug": "vardiyum",
    "scheme": "vardiyum",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hilmiguner.vardiyum"
    },
    "android": {
      "package": "com.hilmiguner.vardiyum"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
